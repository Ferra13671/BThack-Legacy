//Commands
"lang.command.ClanList.description": Показывает весь список кланов, а также их участников.
"lang.command.Help.description": Перечисляет все существующие команды BThack.
"lang.command.PluginList.description": Показывает весь список плагинов.
"lang.command.EnemyList.description": Показывает весь список врагов.
"lang.command.FriendList.description": Показывает весь список друзей.
"lang.command.BlockList.description": Показывает весь список %s блоков.
"lang.command.ItemList.description": Показывает весь список %s предметов.
"lang.command.PacketList.description": Показывает весь список %s пакетов.
"lang.command.ClanMembers.description": Добавляет/удаляет участника клана.
"lang.command.Clans.description": Добавляет/удаляет клан.
"lang.command.ClanStatus.description": Изменяет статус клана.
"lang.command.Enemies.description": Добавляет/удаляет врага.
"lang.command.Friends.description": Добавляет/удаляет друга.
"lang.command.CleanMemory.description": Очищает ОЗУ.
"lang.command.EntitiesNearby.description": Пишет, сколько энтити находится рядом с вами.
"lang.command.Prefix.description": Изменяет текущий префикс на другой префикс.
"lang.command.Refresh.description": Обновляет список друзей/врагов/союзников (необходимо, если вы изменили список через txt-файл).
"lang.command.Rotate.description": Поворачивает камеру игрока по заданным числам.
"lang.command.ListBlock.description": Добавляет/удаляет блок из %s списка.
"lang.command.ListItem.description": Добавляет/удаляет предмет из %s списка.
"lang.command.Bind.description": Биндит модуль на указаную клавишу.
"lang.command.BreakCommand.description": Ломает блок по выбранным координатам относительно игрока.
"lang.command.BuildCommand.description": Ставит блок по выбранным координатам относительно игрока.
"lang.command.SoundReloadCommand.description": Перезагружает звуковой менеджер.
"lang.command.HClipCommand.description": Позволяет телепортироваться по горизонтали.
"lang.command.VClipCommand.description": Позволяет телепортироваться по вертикали.
"lang.command.Config.description": Сохраняет/загружает конфиг.
"lang.command.DisableAll.description": Отключает все модули (кроме тех, что находятся в категории CLIENT).
"lang.command.ClientGamemode.description": Устанавливает гейммод на стороне клиента.
"lang.command.AutoAuth.description": Добавляет/удаляет пароль для определенного ника.
"lang.command.Module.description": Выполняет определенное действие над модулем.
"lang.command.CordsCopy.description": Копирует координаты игрока.
"lang.command.CustomFont.description": Позволяет выбрать пользовательский шрифт из папки или установить шрифт по умолчанию.
"lang.command.Waypoint.description": Добавляет, удаляет, изменяет вейпоинт или показывает список вейпоинтов.
"lang.command.Macro.description": Добавляет, удаляет, изменяет макрос или показывает список макросов.
"lang.command.CustomCape.description": Устанавливает пользовательский плащ по умолчанию или с помощью файла или ссылки.
"lang.command.OpenFolder.description": Открывает папку конфигурации BThack.
"lang.command.Auto2FA.description": Добавляет/удаляет 2fa ключ для определенного ника.


